{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "website-website",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "OPENAI_MODEL": "gpt-5-nano"
  },
  "observability": {
    "enabled": true
  }
}
